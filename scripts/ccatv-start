#!/usr/bin/env bash

set -euo pipefail

REPO_DIR="${HOME}/src/ccatv"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ccatv"
WEB_ENV="${CONFIG_DIR}/web.env"
SYSTEMD_USER_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
RECORDINGS_DIR="${HOME}/.local/share/ccatv/recordings"

mkdir -p "${CONFIG_DIR}" "${SYSTEMD_USER_DIR}" "${RECORDINGS_DIR}"

if [[ ! -d "${REPO_DIR}" ]]; then
  echo "Missing repo directory: ${REPO_DIR}" >&2
  exit 1
fi

UV_BIN="$(command -v uv 2>/dev/null || true)"
if [[ -z "${UV_BIN}" && -x "${HOME}/.local/bin/uv" ]]; then
  UV_BIN="${HOME}/.local/bin/uv"
fi
if [[ -z "${UV_BIN}" || ! -x "${UV_BIN}" ]]; then
  echo "Unable to locate executable 'uv'. Install uv or add it to PATH." >&2
  exit 1
fi

CCATV_DVBSTREAMER_DEBUG_OUTPUT_FLAG="${CCATV_DVBSTREAMER_DEBUG_OUTPUT:-0}"
CCATV_DVBSTREAMER_BIND_ADDRESS_FLAG="${CCATV_DVBSTREAMER_BIND_ADDRESS:-127.0.0.1}"
CCATV_API_START_DELAY_SECONDS_FLAG="${CCATV_API_START_DELAY_SECONDS:-0}"
CCATV_API_READY_TIMEOUT_SECONDS_FLAG="${CCATV_API_READY_TIMEOUT_SECONDS:-60}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug-dvbstreamer-output)
      CCATV_DVBSTREAMER_DEBUG_OUTPUT_FLAG="1"
      shift
      ;;
    --dvbstreamer-bind-address)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --dvbstreamer-bind-address" >&2
        exit 2
      fi
      CCATV_DVBSTREAMER_BIND_ADDRESS_FLAG="$2"
      shift 2
      ;;
    --dvbstreamer-bind-all)
      CCATV_DVBSTREAMER_BIND_ADDRESS_FLAG="0.0.0.0"
      shift
      ;;
    --api-start-delay-seconds)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --api-start-delay-seconds" >&2
        exit 2
      fi
      CCATV_API_START_DELAY_SECONDS_FLAG="$2"
      shift 2
      ;;
    --api-ready-timeout-seconds)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --api-ready-timeout-seconds" >&2
        exit 2
      fi
      CCATV_API_READY_TIMEOUT_SECONDS_FLAG="$2"
      shift 2
      ;;
    --help|-h)
      cat <<'EOF'
Usage: ccatv-start [--debug-dvbstreamer-output] [--dvbstreamer-bind-address ADDRESS] [--dvbstreamer-bind-all] [--api-start-delay-seconds SECONDS] [--api-ready-timeout-seconds SECONDS]

Options:
  --debug-dvbstreamer-output  Set CCATV_DVBSTREAMER_DEBUG_OUTPUT=1 for services.
  --dvbstreamer-bind-address  Set CCATV_DVBSTREAMER_BIND_ADDRESS for services.
  --dvbstreamer-bind-all      Shortcut for --dvbstreamer-bind-address 0.0.0.0.
  --api-start-delay-seconds   Stored for backward compatibility (unused in systemd mode).
  --api-ready-timeout-seconds Stored for backward compatibility (unused in systemd mode).
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Use --help for usage." >&2
      exit 2
      ;;
  esac
done

if ! [[ "${CCATV_API_START_DELAY_SECONDS_FLAG}" =~ ^[0-9]+$ ]]; then
  echo "--api-start-delay-seconds must be a non-negative integer" >&2
  exit 2
fi

if ! [[ "${CCATV_API_READY_TIMEOUT_SECONDS_FLAG}" =~ ^[0-9]+$ ]]; then
  echo "--api-ready-timeout-seconds must be a non-negative integer" >&2
  exit 2
fi

ensure_web_env() {
  local service_token=""
  local web_token=""
  local web_session_secret=""
  local api_bind_host="127.0.0.1"
  local api_port="8787"
  local web_listen_host="0.0.0.0"
  local web_listen_port="5000"
  local web_service_host="127.0.0.1"
  local web_service_port="8787"
  local comskip_ini_path="/home/chris/.config/comskip/comskip.ini"
  local sd_lineup_id=""

  if [[ -f "${WEB_ENV}" ]]; then
    # shellcheck disable=SC1090
    source "${WEB_ENV}"
    service_token="${CCATV_SERVICE_AUTH_TOKEN:-}"
    web_token="${CCATV_WEB_AUTH_TOKEN:-}"
    web_session_secret="${CCATV_WEB_SESSION_SECRET:-}"
    api_bind_host="${CCATV_API_BIND_HOST:-${api_bind_host}}"
    api_port="${CCATV_API_PORT:-${api_port}}"
    web_listen_host="${CCATV_WEB_LISTEN_HOST:-${web_listen_host}}"
    web_listen_port="${CCATV_WEB_LISTEN_PORT:-${web_listen_port}}"
    web_service_host="${CCATV_WEB_SERVICE_HOST:-${web_service_host}}"
    web_service_port="${CCATV_WEB_SERVICE_PORT:-${web_service_port}}"
    comskip_ini_path="${CCATV_COMSKIP_INI_PATH:-${comskip_ini_path}}"
    sd_lineup_id="${CCATV_SD_LINEUP_ID:-}"
  fi

  if [[ -z "${service_token}" ]]; then
    service_token=$(cd "${REPO_DIR}" && uv run python -c 'import secrets; print(secrets.token_urlsafe(48))')
  fi
  if [[ -z "${web_token}" ]]; then
    web_token=$(cd "${REPO_DIR}" && uv run python -c 'import secrets; print(secrets.token_urlsafe(48))')
  fi
  if [[ -z "${web_session_secret}" ]]; then
    web_session_secret=$(cd "${REPO_DIR}" && uv run python -c 'import secrets; print(secrets.token_urlsafe(48))')
  fi

  cat > "${WEB_ENV}" <<EOF
CCATV_SERVICE_AUTH_TOKEN=${service_token}
CCATV_WEB_AUTH_TOKEN=${web_token}
CCATV_WEB_SESSION_SECRET=${web_session_secret}
CCATV_API_BIND_HOST=${api_bind_host}
CCATV_API_PORT=${api_port}
CCATV_WEB_LISTEN_HOST=${web_listen_host}
CCATV_WEB_LISTEN_PORT=${web_listen_port}
CCATV_WEB_SERVICE_HOST=${web_service_host}
CCATV_WEB_SERVICE_PORT=${web_service_port}
CCATV_COMSKIP_INI_PATH=${comskip_ini_path}
CCATV_SD_LINEUP_ID=${sd_lineup_id}
EOF
  chmod 600 "${WEB_ENV}"
}

load_web_env() {
  # shellcheck disable=SC1090
  source "${WEB_ENV}"
}

systemctl_user() {
  local uid
  uid=$(id -u)
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
  local bus="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${runtime_dir}/bus}"

  if [[ -S "${runtime_dir}/bus" ]]; then
    XDG_RUNTIME_DIR="${runtime_dir}" DBUS_SESSION_BUS_ADDRESS="${bus}" systemctl --user "$@"
    return
  fi

  systemctl --user "$@"
}

stop_legacy_ccatv_processes() {
  local pids
  pids=$(pgrep -f 'uv run ccatv-(service|web)|/ccatv/.venv/bin/ccatv-(service|web)' || true)
  if [[ -z "${pids}" ]]; then
    return
  fi

  local terminated=0
  local pid
  for pid in ${pids}; do
    if [[ ! -r "/proc/${pid}/cgroup" ]]; then
      continue
    fi

    if grep -Eq 'ccatv(\-api|\-web)?\.service|ccatv\.service' "/proc/${pid}/cgroup"; then
      continue
    fi

    if kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
      terminated=1
    fi
  done

  if [[ "${terminated}" -eq 1 ]]; then
    echo "Terminated legacy unmanaged ccatv processes before starting systemd user services."
  fi
}

write_repo_units() {
  local uv_bin_escaped
  uv_bin_escaped=${UV_BIN@Q}

  cat > "${SYSTEMD_USER_DIR}/ccatv.service" <<EOF
[Unit]
Description=ccatv scheduler daemon (repo workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-${WEB_ENV}
ExecStart=/usr/bin/env bash -lc 'cd %h/src/ccatv && exec env CCATV_SD_LINEUP_ID="\${CCATV_SD_LINEUP_ID:-}" CCATV_DVBSTREAMER_BIND_ADDRESS="\${CCATV_DVBSTREAMER_BIND_ADDRESS:-127.0.0.1}" CCATV_DVBSTREAMER_DEBUG_OUTPUT="\${CCATV_DVBSTREAMER_DEBUG_OUTPUT:-0}" CCATV_DVBSTREAMER_MANAGE_PROCESS="1" ${uv_bin_escaped} run ccatv-service --output-directory %h/.local/share/ccatv/recordings --poll-interval-seconds 5 --enable-daily-metadata-sync --daily-metadata-sync-time 03:00'
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=%h/.local/share/ccatv
ReadWritePaths=%h/.config/ccatv

[Install]
WantedBy=default.target
EOF

  cat > "${SYSTEMD_USER_DIR}/ccatv-api.service" <<EOF
[Unit]
Description=ccatv HTTP API transport (repo workspace)
After=network-online.target ccatv.service
Wants=network-online.target ccatv.service

[Service]
Type=simple
Environment=CCATV_API_BIND_HOST=127.0.0.1
Environment=CCATV_API_PORT=8787
EnvironmentFile=${WEB_ENV}
ExecStart=/usr/bin/env bash -lc 'cd %h/src/ccatv && exec env CCATV_LOG_LEVEL="\${CCATV_LOG_LEVEL:-INFO}" CCATV_DVBSTREAMER_BIND_ADDRESS="\${CCATV_DVBSTREAMER_BIND_ADDRESS:-127.0.0.1}" CCATV_DVBSTREAMER_DEBUG_OUTPUT="\${CCATV_DVBSTREAMER_DEBUG_OUTPUT:-0}" CCATV_DVBSTREAMER_MANAGE_PROCESS="0" ${uv_bin_escaped} run ccatv-service --http-bind-host "\${CCATV_API_BIND_HOST}" --http-port "\${CCATV_API_PORT}" --http-auth-token "\${CCATV_SERVICE_AUTH_TOKEN}"'
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=%h/.local/share/ccatv
ReadWritePaths=%h/.config/ccatv

[Install]
WantedBy=default.target
EOF

  cat > "${SYSTEMD_USER_DIR}/ccatv-web.service" <<EOF
[Unit]
Description=ccatv Flask web frontend (repo workspace)
After=network-online.target ccatv-api.service
Wants=network-online.target ccatv-api.service

[Service]
Type=simple
Environment=CCATV_WEB_LISTEN_HOST=0.0.0.0
Environment=CCATV_WEB_LISTEN_PORT=5000
Environment=CCATV_WEB_SERVICE_HOST=127.0.0.1
Environment=CCATV_WEB_SERVICE_PORT=8787
EnvironmentFile=${WEB_ENV}
ExecStart=/usr/bin/env bash -lc 'cd %h/src/ccatv && exec env CCATV_SERVICE_AUTH_TOKEN="\${CCATV_SERVICE_AUTH_TOKEN}" CCATV_WEB_AUTH_TOKEN="\${CCATV_WEB_AUTH_TOKEN}" CCATV_WEB_SESSION_SECRET="\${CCATV_WEB_SESSION_SECRET}" CCATV_LOG_LEVEL="\${CCATV_LOG_LEVEL:-INFO}" ${uv_bin_escaped} run ccatv-web --listen-host "\${CCATV_WEB_LISTEN_HOST}" --listen-port "\${CCATV_WEB_LISTEN_PORT}" --service-host "\${CCATV_WEB_SERVICE_HOST}" --service-port "\${CCATV_WEB_SERVICE_PORT}"'
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
EOF
}

ensure_web_env
load_web_env

print_active_script_paths() {
  local start_cmd=""
  local stop_cmd=""
  local start_real=""
  local stop_real=""

  start_cmd=$(command -v ccatv-start 2>/dev/null || true)
  stop_cmd=$(command -v ccatv-stop 2>/dev/null || true)

  if [[ -n "${start_cmd}" ]]; then
    start_real=$(readlink -f "${start_cmd}" 2>/dev/null || echo "${start_cmd}")
  fi
  if [[ -n "${stop_cmd}" ]]; then
    stop_real=$(readlink -f "${stop_cmd}" 2>/dev/null || echo "${stop_cmd}")
  fi

  echo "Active commands:"
  echo "  ccatv-start: ${start_real:-<not found>}"
  echo "  ccatv-stop:  ${stop_real:-<not found>}"
  echo "  repo start:  ${REPO_DIR}/scripts/ccatv-start"
  echo "  repo stop:   ${REPO_DIR}/scripts/ccatv-stop"
}

print_active_script_paths
echo "dvbstreamer debug output: ${CCATV_DVBSTREAMER_DEBUG_OUTPUT_FLAG}"
echo "dvbstreamer bind address: ${CCATV_DVBSTREAMER_BIND_ADDRESS_FLAG}"
echo "api start delay seconds: ${CCATV_API_START_DELAY_SECONDS_FLAG}"
echo "api ready timeout seconds: ${CCATV_API_READY_TIMEOUT_SECONDS_FLAG}"

# Persist service overrides to shared env so all units see the same values.
python3 - <<PY
from pathlib import Path

env_path = Path(${WEB_ENV@Q})
lines = env_path.read_text().splitlines()
kv = {}
for line in lines:
    if not line or line.lstrip().startswith('#') or '=' not in line:
        continue
    key, value = line.split('=', 1)
    kv[key] = value

kv['CCATV_DVBSTREAMER_BIND_ADDRESS'] = ${CCATV_DVBSTREAMER_BIND_ADDRESS_FLAG@Q}
kv['CCATV_DVBSTREAMER_DEBUG_OUTPUT'] = ${CCATV_DVBSTREAMER_DEBUG_OUTPUT_FLAG@Q}
kv.setdefault('CCATV_SD_LINEUP_ID', kv.get('CCATV_SD_LINEUP_ID', ''))

ordered_keys = [
    'CCATV_SERVICE_AUTH_TOKEN',
    'CCATV_WEB_AUTH_TOKEN',
    'CCATV_WEB_SESSION_SECRET',
    'CCATV_API_BIND_HOST',
    'CCATV_API_PORT',
    'CCATV_WEB_LISTEN_HOST',
    'CCATV_WEB_LISTEN_PORT',
    'CCATV_WEB_SERVICE_HOST',
    'CCATV_WEB_SERVICE_PORT',
    'CCATV_COMSKIP_INI_PATH',
    'CCATV_SD_LINEUP_ID',
    'CCATV_DVBSTREAMER_BIND_ADDRESS',
    'CCATV_DVBSTREAMER_DEBUG_OUTPUT',
]

output = []
for key in ordered_keys:
    if key in kv:
        output.append(f"{key}={kv[key]}")
for key in sorted(kv.keys()):
    if key not in ordered_keys:
        output.append(f"{key}={kv[key]}")

env_path.write_text("\n".join(output) + "\n")
PY

cd "${REPO_DIR}"
"${UV_BIN}" sync
write_repo_units
stop_legacy_ccatv_processes

systemctl_user daemon-reload
systemctl_user enable --now ccatv.service ccatv-api.service ccatv-web.service

echo "Services started under systemd --user."
echo "Shared env: ${WEB_ENV}"
echo "Web URL: http://$(hostname):${CCATV_WEB_LISTEN_PORT}"
echo "Follow logs with: journalctl --user-unit ccatv.service -f"
