#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ccatv-stop

Stop ccatv-web, ccatv-api, and ccatv-service via systemd --user.
EOF
}

if [[ $# -gt 0 ]]; then
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Use --help for usage." >&2
      exit 2
      ;;
  esac
fi

systemctl_user() {
  local uid
  uid=$(id -u)
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
  local bus="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${runtime_dir}/bus}"

  if [[ -S "${runtime_dir}/bus" ]]; then
    XDG_RUNTIME_DIR="${runtime_dir}" DBUS_SESSION_BUS_ADDRESS="${bus}" systemctl --user "$@"
    return
  fi

  systemctl --user "$@"
}

systemctl_user stop ccatv-web.service ccatv-api.service ccatv.service
echo "Stopped ccatv-web, ccatv-api, and ccatv-service via systemd --user"
